# ---- target -------------------------------------------------------------
BASE_URL=
# Endpoint that returns slot availability. Fill in from the HAR capture.
SLOTS_PATH=/api/appointment/slots
SLOTS_METHOD=GET

# ---- access -------------------------------------------------------------
# Optional network routing, e.g. if access is region-limited and you have a
# legitimate presence there.
PROXY_URL=
# Headers / cookies from a session you are authorised to use, as JSON objects.
# SESSION_HEADERS={"Authorization": "Bearer ..."}
# SESSION_COOKIES={"sessionid": "..."}
SESSION_HEADERS={}
SESSION_COOKIES={}

# ---- polling ------------------------------------------------------------
POLL_INTERVAL_SEC=6          # base interval; actual delay is this +/- jitter
POLL_JITTER_SEC=2            # so the request pattern is not a metronome
MAX_BACKOFF_SEC=300          # ceiling for exponential backoff on errors
MAX_CONSECUTIVE_ERRORS=20    # give up (and say so) after this many

# ---- discord ------------------------------------------------------------
DISCORD_WEBHOOK_URL=
DISCORD_MENTION=<@&000000000000000000>    # role id to ping, or @here, or blank
DISCORD_HEARTBEAT_WEBHOOK_URL=            # separate channel for liveness

# ---- ops ----------------------------------------------------------------
HEARTBEAT_EVERY_SEC=1800
STATE_FILE=state.json
LOG_LEVEL=INFO
